# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://clannova.com

# Lead storage (server-only). Without these the form validates but reports that
# enquiries are not connected, instead of claiming delivery.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional contact details and social profiles; each is shown only when set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_WHATSAPP_NUMBER=        # e.g. 919876543210 (country code, digits only)

# New-enquiry email alerts via Resend (https://resend.com). Comma-separate several recipients.
RESEND_API_KEY=
LEAD_ALERT_EMAIL=
# Optional: a sender on a domain you verified in Resend. Defaults to Resend's test sender.
LEAD_ALERT_FROM=

# Cloudflare Turnstile bot protection (https://dash.cloudflare.com -> Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
